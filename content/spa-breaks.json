  "sections": [
    {
      "h2": "Getting the best spa break deal",
      "html": "<ul><li><strong>Check what’s included.</strong> Some rates include spa access and a treatment; others are room only, with spa use charged extra.</li>\n<li><strong>Book treatments early.</strong> Popular slots go fast, especially at weekends.</li>\n<li><strong>Go midweek.</strong> Countryside spa hotels are often cheaper from Sunday to Thursday.</li>\n<li><strong>Read the age rules.</strong> Many spas are adults-only or have set times for children.</li></ul>"
    }
  ],
  "faqs": [
    {
      "q": "Is a spa package better value than booking separately?",
      "a": "Sometimes. Compare the package price against the room-only rate plus the spa’s own prices for the treatments you want. Packages can include extras like dinner or late checkout that are worth having."
    }
  ],
