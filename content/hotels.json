  "sections": [
    {
      "h2": "Choosing where to stay in a UK city",
      "html": "<ul><li><strong>Central is handy, but not always best value.</strong> In big cities, hotels a few stops out on the tube, tram or train can cost less and still be quick to reach.</li>\n<li><strong>Check for events.</strong> Concerts, football, festivals and graduation weeks fill hotels fast and push prices up.</li>\n<li><strong>Parking matters.</strong> Many city-centre hotels charge for parking or have none, so check before you drive.</li></ul>"
    }
